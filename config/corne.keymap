#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <185>;
            flavor = "tap-preferred";
            quick-tap-ms = <185>;
        };
    };

    combos {
        compatible = "zmk,combos";

        caps {
            bindings = <&kp CAPS>;
            key-positions = <16 19>;
        };

        under {
            bindings = <&kp UNDER>;
            key-positions = <28 31>;
        };

        dash {
            bindings = <&kp MINUS>;
            key-positions = <4 7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        home {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none  &kp Q            &kp W                &kp E                    &kp R                  &kp T        &kp Y        &kp U              &kp I             &kp O                 &kp P                    &none
&none  &hm LGUI A  &hm LEFT_ALT S  &hm LEFT_CONTROL D  &hm LEFT_SHIFT F  &kp G        &kp H        &hm RSHIFT J  &hm RCTRL K  &hm RIGHT_ALT L  &hm LGUI SEMICOLON  &none
&none  &kp Z            &kp X                &kp C                    &kp V                  &kp B        &kp N        &kp M              &kp COMMA         &kp PERIOD            &kp SLASH                &none
                                             &kp ESCAPE               &lt 1 BACKSPACE        &lt 2 TAB    &lt 2 ENTER  &lt 1 SPACE        &lt 3 LGUI
            >;

            label = "home";
        };

        num {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &kp EXCL            &kp AT               &kp LEFT_BRACE              &kp RIGHT_BRACE                   &kp PIPE     &kp PLUS   &kp NUMBER_7  &kp N8        &kp N9                    &kp ASTERISK   &none
&none  &hm LEFT_META HASH  &hm LEFT_ALT DOLLAR  &hm LCTRL LEFT_PARENTHESIS  &hm LEFT_SHIFT RIGHT_PARENTHESIS  &kp GRAVE    &kp MINUS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6              &kp COLON      &none
&none  &kp PERCENT         &kp CARET            &kp LEFT_BRACKET            &kp RIGHT_BRACKET                 &kp TILDE    &kp EQUAL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH  &none
                                                &kp SLASH                   &kp QUESTION                      &kp DEL      &kp RET    &kp SPACE     &kp N0
            >;

            label = "num";
        };

        nav {
            bindings = <
&trans  &kp F1            &kp F2           &kp F3        &kp F4             &trans             &trans  &kp LS(H)  &kp PG_DN    &kp PG_UP  &kp LS(L)  &trans
&trans  &hm LEFT_META F5  &hm LEFT_ALT F6  &hm LCTRL F7  &hm LEFT_SHIFT F8  &hm LC(V) LC(C)    &trans  &hm RSHIFT LEFT  &hm RCTRL DOWN  &hm RIGHT_ALT UP  &hm LGUI RIGHT  &trans
&trans  &kp F9            &kp F10          &kp F11       &kp F12            &kp PSCRN          &trans  &kp LA(H)  &kp LA(TAB)  &trans     &kp LA(L)  &trans
                                           &bt BT_CLR    &bt BT_NXT         &trans             &trans  &trans     &trans
            >;

            label = "nav";
        };

        spaces {
            bindings = <
&trans  &trans     &trans     &trans     &trans          &trans       &trans     &kp LG(G)  &kp LG(C)  &kp LG(R)  &kp LG(L)  &trans
&trans  &kp LG(A)  &kp LG(O)  &kp LG(E)  &kp LG(U)       &kp LG(I)    &kp LG(D)  &kp LG(H)  &kp LG(T)  &kp LG(N)  &kp LG(S)  &trans
&trans  &trans     &trans     &trans     &trans          &trans       &trans     &kp LG(M)  &kp LG(W)  &trans     &trans     &trans
                              &trans     &kp LEFT_SHIFT  &trans       &trans     &trans     &trans
            >;
        };
    };
};
